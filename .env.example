# ──────────────────────────────────────────────────────────────────────────────
# Catch Comics — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# All vars must also be added to Vercel dashboard (Settings → Environment Variables).
# ──────────────────────────────────────────────────────────────────────────────


# ── PostgreSQL / Prisma ───────────────────────────────────────────────────────
# Connection string for the Prisma ORM.
#
# Local development:
#   postgresql://postgres:password@localhost:5432/catch_comics
#
# Neon (recommended for Vercel deploys):
#   postgresql://<user>:<password>@<host>.neon.tech/catch_comics?sslmode=require
#
# After setting this, run:
#   npm run db:generate       — generate the Prisma client
#   npm run db:migrate:dev    — apply migrations locally
DATABASE_URL=


# ── Comic Vine ────────────────────────────────────────────────────────────────
# Get your key at: https://comicvine.gamespot.com/api/
COMIC_VINE_API_KEY=


# ── eBay Buy Browse API ───────────────────────────────────────────────────────
# Create an app at: https://developer.ebay.com/
# Client ID prefix -SBX- = sandbox, -PRD- = production (auto-detected)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marketplace identifiers — set exactly as shown
EBAY_MARKETPLACE_ID_UK=EBAY_GB
EBAY_MARKETPLACE_ID_US=EBAY_US


# ── AWIN (affiliate network — datafeeds + link wrapping) ─────────────────────
# All three are SERVER-ONLY secrets — no NEXT_PUBLIC_ prefix, never import in
# client components. scripts/test-secret-hygiene.ts enforces this.
#
# AWIN_PUBLISHER_ID   — publisher (affiliate) id used in link wrapping
# AWIN_API_KEY        — AWIN API access
# AWIN_DATAFEED_KEY   — product datafeed download key (sync:awin).
#   Get/rotate: AWIN dashboard → Toolbox → Product Feeds → download key.
#   ⚠ Rotating after a git-history leak: REGENERATE in the dashboard (don't
#   re-copy the old value), then update .env.local AND Vercel.
AWIN_PUBLISHER_ID=
AWIN_API_KEY=
AWIN_DATAFEED_KEY=


# ── Amazon Associates ─────────────────────────────────────────────────────────
# These tags appear in public URLs — NOT secrets. NEXT_PUBLIC_ prefix is correct
# and required so client components (PricingPanel) can build affiliate URLs.
#
# Find your tag at: https://affiliate-program.amazon.co.uk/ (UK)
#                   https://affiliate-program.amazon.com/   (US)
#
# UK tag format:  yourname-21
# US tag format:  yourname-20
#
# UK: set the real tag (catchcomics-21 in production).
# US: MUST stay blank until a genuine US tag exists — never reuse the UK tag
#     (test:amazon enforces this; untagged US links are the correct behaviour).
NEXT_PUBLIC_AMAZON_UK_ASSOCIATE_TAG=
NEXT_PUBLIC_AMAZON_US_ASSOCIATE_TAG=


# ── Amazon Creators API ───────────────────────────────────────────────────────
# Replaces PA-API 5.0 (retired by Amazon May 2026). The client is implemented
# (lib/amazonCreators.ts); NO importer or backfill exists yet.
#
# ⚠ ALL THREE CREDENTIAL VARS ARE SECRETS. No NEXT_PUBLIC_ prefix, ever, and
#   never import lib/amazonCreatorsEnv.ts from a 'use client' component.
#   scripts/test-secret-hygiene.ts enforces both rules.
#
# Source: the credential CSV downloaded from the Amazon Creators dashboard.
#   AMAZON_CREATORS_CLIENT_ID          ← CSV "Credential ID"  (amzn1.application-oa2-client.…)
#   AMAZON_CREATORS_CLIENT_SECRET      ← CSV "Secret"         (amzn1.oa2-cs.v1.…)
#   AMAZON_CREATORS_CREDENTIAL_VERSION ← CSV "Version"        (e.g. 3.2 — UK/EU;
#                                        3.1 = US/CA/MX/BR, 3.3 = JP/IN/AU.
#                                        Selects the Login-with-Amazon region.)
#
# Values go in unquoted, on one line, with no spaces around the "=".
# Rotating: regenerate in the Amazon dashboard (never re-copy an old value),
# then update .env.local AND Vercel.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=

# Marketplace host the Creators credentials are scoped to. Host only — no
# https://, no trailing slash. UK is the launch market.
AMAZON_CREATORS_MARKETPLACE=www.amazon.co.uk

# Server-side associate tag. NOT a secret (it appears in every affiliate URL),
# but the Creators integration is server-side and lib/amazon.ts already
# documents this name for server routes. OPTIONAL — if unset it falls back to
# NEXT_PUBLIC_AMAZON_UK_ASSOCIATE_TAG, so you do not have to enter it twice.
AMAZON_UK_ASSOCIATE_TAG=catchcomics-21


# ── Verify without revealing anything ─────────────────────────────────────────
#   npm run amazon:creators:check   — reports present/missing + lengths only,
#                                     never prints a credential value.


# ── Catch Cost Guard (multi-provider spend monitoring + circuit breakers) ────
# See launch/operations/COST-GUARD.md for the runbook and exact setup steps.
# ALL of these are SERVER-ONLY secrets — no NEXT_PUBLIC_ prefix, never import
# from client components.
#
# Shared secret authenticating the hourly GitHub Actions collection call to
# POST /api/costguard/collect. Must be set BOTH here/Vercel AND as the
# GitHub Actions repo secret COSTGUARD_CRON_SECRET (same value).
COSTGUARD_CRON_SECRET=

# Shared secret in the Vercel Spend Management webhook URL
# (…/api/costguard/vercel-webhook?token=<value>).
COSTGUARD_WEBHOOK_SECRET=

# Neon: Account settings → API keys → Create key ("costguard-read").
NEON_API_KEY=

# GitHub: fine-grained PAT, permission "Plan: read-only" only.
GITHUB_BILLING_TOKEN=

# Cloudflare: API token with Account Analytics:Read; account id from the
# dashboard URL. Both optional — R2 monitoring is skipped without them.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: mirrors the Vercel Spend Management limit so percentage maths in
# webhook payloads that omit the limit still resolve. Not a secret.
VERCEL_SPEND_LIMIT_USD=100
